{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "message_type": {
      "const": "measure",
      "title": "Message Type",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sensor_profile": {
      "default": "basic",
      "enum": [
        "basic",
        "extended"
      ],
      "title": "Sensor Profile",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "message_type",
    "request_id"
  ],
  "title": "SensorMeasureRequest",
  "type": "object"
}
