{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_key": {
      "maxLength": 128,
      "minLength": 32,
      "title": "Api Key",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "installation_id": {
      "format": "uuid",
      "title": "Installation Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "server_id": {
      "const": "visionmachine-4090",
      "title": "Server Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "server_id",
    "installation_id",
    "api_key",
    "expires_at"
  ],
  "title": "DeviceRegistrationResult",
  "type": "object"
}
