{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "app_version_code": {
      "minimum": 6,
      "title": "App Version Code",
      "type": "integer"
    },
    "installation_id": {
      "format": "uuid",
      "title": "Installation Id",
      "type": "string"
    },
    "registration_secret": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registration Secret",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "installation_id",
    "registration_secret",
    "app_version_code"
  ],
  "title": "DeviceRegistrationRequest",
  "type": "object"
}
