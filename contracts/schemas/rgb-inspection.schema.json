{
  "$defs": {
    "OpticalReadings": {
      "additionalProperties": false,
      "properties": {
        "astep": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Astep",
          "type": "integer"
        },
        "atime": {
          "maximum": 255,
          "minimum": 0,
          "title": "Atime",
          "type": "integer"
        },
        "channel_order": {
          "const": "F1,F2,F3,F4,CLEAR_1,NIR_1,F5,F6,F7,F8,CLEAR_2,NIR_2",
          "title": "Channel Order",
          "type": "string"
        },
        "finished_uptime_ms": {
          "minimum": 0,
          "title": "Finished Uptime Ms",
          "type": "integer"
        },
        "gain_x": {
          "exclusiveMinimum": 0,
          "maximum": 512,
          "title": "Gain X",
          "type": "number"
        },
        "i2c_address": {
          "const": 57,
          "title": "I2C Address",
          "type": "integer"
        },
        "illumination": {
          "const": "ambient",
          "title": "Illumination",
          "type": "string"
        },
        "integration_time_ms": {
          "exclusiveMinimum": 0,
          "title": "Integration Time Ms",
          "type": "number"
        },
        "led_enabled": {
          "title": "Led Enabled",
          "type": "boolean"
        },
        "raw_counts": {
          "items": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 12,
          "minItems": 12,
          "title": "Raw Counts",
          "type": "array"
        },
        "saturated": {
          "title": "Saturated",
          "type": "boolean"
        },
        "sensor": {
          "const": "AS7341",
          "title": "Sensor",
          "type": "string"
        },
        "started_uptime_ms": {
          "minimum": 0,
          "title": "Started Uptime Ms",
          "type": "integer"
        },
        "status2": {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Status2",
          "type": "array"
        }
      },
      "required": [
        "sensor",
        "i2c_address",
        "raw_counts",
        "channel_order",
        "gain_x",
        "atime",
        "astep",
        "integration_time_ms",
        "illumination",
        "led_enabled",
        "status2",
        "saturated",
        "started_uptime_ms",
        "finished_uptime_ms"
      ],
      "title": "OpticalReadings",
      "type": "object"
    },
    "RgbPhotoMetadata": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "default": "unassigned",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Batch Id",
          "type": "string"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "crop_code": {
          "enum": [
            "tomato",
            "cherry_tomato",
            "pepper",
            "cucumber",
            "lettuce",
            "bok_choy",
            "kale",
            "eggplant",
            "basil",
            "rosemary"
          ],
          "title": "Crop Code",
          "type": "string"
        },
        "image_media_type": {
          "enum": [
            "image/jpeg",
            "image/png"
          ],
          "title": "Image Media Type",
          "type": "string"
        },
        "image_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "sensor": {
          "anyOf": [
            {
              "$ref": "#/$defs/RgbSensorAttachment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_photo_id": {
          "format": "uuid",
          "title": "Source Photo Id",
          "type": "string"
        },
        "subject_id": {
          "default": "unassigned",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "source_photo_id",
        "crop_code",
        "image_sha256",
        "image_media_type"
      ],
      "title": "RgbPhotoMetadata",
      "type": "object"
    },
    "RgbSensorAttachment": {
      "additionalProperties": false,
      "properties": {
        "assessment_json": {
          "anyOf": [
            {
              "maxLength": 64000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessment Json"
        },
        "crop_code": {
          "enum": [
            "tomato",
            "cherry_tomato",
            "pepper",
            "cucumber",
            "lettuce",
            "bok_choy",
            "kale",
            "eggplant",
            "basil",
            "rosemary"
          ],
          "title": "Crop Code",
          "type": "string"
        },
        "packet": {
          "$ref": "#/$defs/SensorPacket"
        },
        "photo_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Photo Sha256",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "sensor_record_id": {
          "format": "uuid",
          "title": "Sensor Record Id",
          "type": "string"
        },
        "source_photo_id": {
          "format": "uuid",
          "title": "Source Photo Id",
          "type": "string"
        }
      },
      "required": [
        "sensor_record_id",
        "source_photo_id",
        "crop_code",
        "photo_sha256",
        "received_at",
        "packet"
      ],
      "title": "RgbSensorAttachment",
      "type": "object"
    },
    "SensorExtensions": {
      "additionalProperties": false,
      "properties": {
        "optical": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpticalReadings"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "surface_temperature": {
          "anyOf": [
            {
              "$ref": "#/$defs/SurfaceTemperatureReadings"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "optical",
        "surface_temperature"
      ],
      "title": "SensorExtensions",
      "type": "object"
    },
    "SensorPacket": {
      "additionalProperties": false,
      "properties": {
        "boot_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Boot Id",
          "type": "string"
        },
        "calibration_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calibration Id"
        },
        "device_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Device Id",
          "type": "string"
        },
        "errors": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "extensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/SensorExtensions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "firmware_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Firmware Version",
          "type": "string"
        },
        "message_type": {
          "const": "measurement",
          "title": "Message Type",
          "type": "string"
        },
        "mode": {
          "enum": [
            "real",
            "mock"
          ],
          "title": "Mode",
          "type": "string"
        },
        "readings": {
          "$ref": "#/$defs/SensorReadings"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "uptime_ms": {
          "minimum": 0,
          "title": "Uptime Ms",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "device_id",
        "boot_id",
        "firmware_version",
        "sequence",
        "uptime_ms",
        "mode",
        "calibration_id",
        "readings",
        "errors"
      ],
      "title": "SensorPacket",
      "type": "object"
    },
    "SensorReadings": {
      "additionalProperties": false,
      "properties": {
        "air_rh_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Air Rh Pct"
        },
        "air_temp_c": {
          "anyOf": [
            {
              "minimum": -273.15,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Air Temp C"
        },
        "soil_adc_bits": {
          "enum": [
            10,
            12,
            14
          ],
          "title": "Soil Adc Bits",
          "type": "integer"
        },
        "soil_index": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Soil Index"
        },
        "soil_raw": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Soil Raw"
        }
      },
      "required": [
        "soil_adc_bits",
        "soil_raw",
        "soil_index",
        "air_temp_c",
        "air_rh_pct"
      ],
      "title": "SensorReadings",
      "type": "object"
    },
    "SurfaceTemperatureReadings": {
      "additionalProperties": false,
      "properties": {
        "ambient_raw": {
          "exclusiveMaximum": 32768,
          "exclusiveMinimum": 0,
          "title": "Ambient Raw",
          "type": "integer"
        },
        "ambient_temp_c": {
          "maximum": 125,
          "minimum": -40,
          "title": "Ambient Temp C",
          "type": "number"
        },
        "emissivity": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Emissivity",
          "type": "number"
        },
        "emissivity_raw": {
          "exclusiveMinimum": 0,
          "maximum": 65535,
          "title": "Emissivity Raw",
          "type": "integer"
        },
        "i2c_address": {
          "const": 90,
          "title": "I2C Address",
          "type": "integer"
        },
        "object_raw": {
          "exclusiveMaximum": 32768,
          "exclusiveMinimum": 0,
          "title": "Object Raw",
          "type": "integer"
        },
        "object_temp_c": {
          "maximum": 380,
          "minimum": -70,
          "title": "Object Temp C",
          "type": "number"
        },
        "pec_checked": {
          "title": "Pec Checked",
          "type": "boolean"
        },
        "read_uptime_ms": {
          "minimum": 0,
          "title": "Read Uptime Ms",
          "type": "integer"
        },
        "sensor": {
          "const": "MLX90614",
          "title": "Sensor",
          "type": "string"
        }
      },
      "required": [
        "sensor",
        "i2c_address",
        "object_raw",
        "ambient_raw",
        "object_temp_c",
        "ambient_temp_c",
        "emissivity_raw",
        "emissivity",
        "pec_checked",
        "read_uptime_ms"
      ],
      "title": "SurfaceTemperatureReadings",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_inspection_id": {
      "format": "uuid",
      "title": "Client Inspection Id",
      "type": "string"
    },
    "photos": {
      "items": {
        "$ref": "#/$defs/RgbPhotoMetadata"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Photos",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "client_inspection_id",
    "photos"
  ],
  "title": "RgbInspectionRequest",
  "type": "object"
}
