            "type": "string"
          },
          "finished_uptime_ms": {
            "minimum": 0.0,
            "title": "Finished Uptime Ms",
            "type": "integer"
          },
          "gain_x": {
            "exclusiveMinimum": 0.0,
            "maximum": 512.0,
