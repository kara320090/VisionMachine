          },
          "integration_time_ms": {
            "exclusiveMinimum": 0.0,
            "title": "Integration Time Ms",
            "type": "number"
          },
          "led_enabled": {
            "title": "Led Enabled",
            "type": "boolean"
          },
          "raw_counts": {
            "items": {
              "maximum": 65535.0,
              "minimum": 0.0,
              "type": "integer"
            },
            "maxItems": 12,
            "minItems": 12,
            "title": "Raw Counts",
            "type": "array"
          },
          "saturated": {
            "title": "Saturated",
            "type": "boolean"
          },
          "sensor": {
            "const": "AS7341",
            "title": "Sensor",
            "type": "string"
          },
          "started_uptime_ms": {
            "minimum": 0.0,
            "title": "Started Uptime Ms",
            "type": "integer"
          },
          "status2": {
            "items": {
              "maximum": 255.0,
              "minimum": 0.0,
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "title": "Status2",
            "type": "array"
          }
        },
        "required": [
          "sensor",
          "i2c_address",
          "raw_counts",
          "channel_order",
          "gain_x",
          "atime",
          "astep",
          "integration_time_ms",
          "illumination",
          "led_enabled",
          "status2",
          "saturated",
          "started_uptime_ms",
          "finished_uptime_ms"
        ],
        "title": "OpticalReadings",
        "type": "object"
      },
