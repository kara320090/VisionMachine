{
  "components": {
    "schemas": {
      "AnalysisResult": {
        "additionalProperties": false,
        "properties": {
          "cause_candidates": {
            "items": {
              "type": "string"
            },
            "title": "Cause Candidates",
            "type": "array"
          },
          "confidence": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "title": "Evidence",
            "type": "array"
          },
          "inspection_id": {
            "format": "uuid",
            "title": "Inspection Id",
            "type": "string"
          },
          "is_mock_input": {
            "title": "Is Mock Input",
            "type": "boolean"
          },
          "model_mode": {
            "anyOf": [
              {
                "enum": [
                  "rgb",
                  "sensor",
                  "fusion"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Mode"
          },
          "model_version": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "origin": {
            "enum": [
              "none",
              "mock",
              "real_model"
            ],
            "title": "Origin",
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "enum": [
                  "no_visible_abnormality",
                  "suspected_abnormality",
                  "inconclusive"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "schema_version": {
            "const": "0.1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending_model",
              "completed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "schema_version",
          "inspection_id",
          "status",
          "origin",
          "is_mock_input",
          "outcome",
          "model_version",
          "model_mode",
          "confidence",
          "evidence",
          "cause_candidates",
          "warnings"
        ],
        "title": "AnalysisResult",
        "type": "object"
      },
      "Body_upload_api_v1_inspections_post": {
        "properties": {
          "payload": {
            "title": "Payload",
            "type": "string"
          },
          "photos": {
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Photos",
            "type": "array"
          }
        },
        "required": [
          "photos",
          "payload"
        ],
        "title": "Body_upload_api_v1_inspections_post",
        "type": "object"
      },
      "Body_upload_inspection_v1_inspections_post": {
        "properties": {
          "metadata": {
            "title": "Metadata",
            "type": "string"
          },
          "photo": {
            "contentMediaType": "application/octet-stream",
            "title": "Photo",
            "type": "string"
          }
        },
        "required": [
          "photo",
          "metadata"
        ],
        "title": "Body_upload_inspection_v1_inspections_post",
        "type": "object"
      },
      "DeviceRegistrationRequest": {
        "additionalProperties": false,
        "properties": {
          "app_version_code": {
            "minimum": 6.0,
            "title": "App Version Code",
            "type": "integer"
          },
          "installation_id": {
            "format": "uuid",
            "title": "Installation Id",
            "type": "string"
          },
          "registration_secret": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Registration Secret",
            "type": "string"
          },
          "schema_version": {
            "const": "0.1.0",
            "default": "0.1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "installation_id",
          "registration_secret",
          "app_version_code"
        ],
        "title": "DeviceRegistrationRequest",
        "type": "object"
      },
      "DeviceRegistrationResult": {
        "additionalProperties": false,
        "properties": {
          "api_key": {
            "maxLength": 128,
            "minLength": 32,
            "title": "Api Key",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "installation_id": {
            "format": "uuid",
            "title": "Installation Id",
            "type": "string"
          },
          "schema_version": {
            "const": "0.1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "server_id": {
            "const": "visionmachine-4090",
            "title": "Server Id",
            "type": "string"
          }
