        "title": "DeviceRegistrationResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InspectionMetadata": {
        "additionalProperties": false,
        "properties": {
          "batch_id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Batch Id",
            "type": "string"
          },
          "capture_source": {
            "enum": [
              "real",
              "synthetic"
            ],
            "title": "Capture Source",
            "type": "string"
          },
          "captured_at": {
            "format": "date-time",
            "title": "Captured At",
            "type": "string"
          },
          "crop_code": {
            "enum": [
              "cherry_tomato",
              "pepper",
              "cucumber",
              "lettuce",
              "bok_choy",
              "eggplant",
              "basil",
              "rosemary"
            ],
            "title": "Crop Code",
            "type": "string"
          },
          "image_media_type": {
            "enum": [
              "image/jpeg",
              "image/png"
            ],
            "title": "Image Media Type",
            "type": "string"
          },
          "image_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Image Sha256",
            "type": "string"
          },
          "inspection_id": {
            "format": "uuid",
            "title": "Inspection Id",
            "type": "string"
          },
          "parent_plant_id": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Plant Id"
          },
          "schema_version": {
            "const": "0.1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "sensor_absence_reason": {
            "anyOf": [
              {
                "enum": [
                  "not_acquired",
                  "disconnected",
                  "permission_denied",
                  "read_error"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sensor Absence Reason"
          },
          "sensor_packet": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SensorPacket"
              },
              {
                "type": "null"
              }
            ]
          },
          "sensor_received_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sensor Received At"
          },
          "subject_id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Subject Id",
            "type": "string"
          },
          "subject_type": {
            "enum": [
              "plant",
              "fruit"
            ],
            "title": "Subject Type",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "inspection_id",
          "subject_id",
          "subject_type",
          "parent_plant_id",
          "batch_id",
          "crop_code",
          "captured_at",
          "capture_source",
          "image_sha256",
          "image_media_type",
          "sensor_packet",
          "sensor_received_at",
          "sensor_absence_reason"
        ],
        "title": "InspectionMetadata",
        "type": "object"
      },
      "OpticalReadings": {
        "additionalProperties": false,
        "properties": {
          "astep": {
            "maximum": 65535.0,
            "minimum": 0.0,
