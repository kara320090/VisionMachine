# python -m vm_server init-db reads this value from the process environment.
# A .env file is NOT auto-loaded. Set $env:VM_STORAGE_DIR in PowerShell,
# or export VM_STORAGE_DIR in a POSIX shell before running the command.
VM_STORAGE_DIR=./storage
VM_HOST=127.0.0.1
VM_PORT=8000
VM_API_KEY=
# Explicitly enable installation-scoped automatic enrollment for the internal app.
VM_DEVICE_ENROLLMENT_ENABLED=0
VM_DEVICE_LIMIT=100
# GPU runner loads .env. Plain uvicorn and the original init-db CLI do not.
# VM_RGB_MODEL_PATH defaults to apps/android/app/src/main/assets/vision_rgb_cseed42.onnx.
# SQLite: <VM_STORAGE_DIR>/visionmachine.db
# Photos: <VM_STORAGE_DIR>/uploads (local-only HTTP development storage).
# Credentials belong only in an untracked .env or secret manager.
